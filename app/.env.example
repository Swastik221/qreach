# Copy to .env.local (local) or set in the hosting dashboard (Vercel: Project > Settings > Environment Variables).
# Every variable here is PUBLIC: it is compiled into the browser bundle. Never put a private key,
# mnemonic, API key or any other secret in a NEXT_PUBLIC_ variable.

# Required. 1990 = QIE mainnet (the hackathon submission), 1983 = QIE testnet, 31337 = local anvil.
# Mainnet RPC (https://rpc1mainnet.qie.digital) and explorer (https://mainnet.qie.digital) are built in.
NEXT_PUBLIC_CHAIN_ID=1990

# Required. QREACH contract address, from contracts/broadcast/Deploy.s.sol/<chain>/run-latest.json
# (field: transactions[0].contractAddress). Leave empty until a deployment really exists; the app
# then shows "The contract address is not configured." instead of guessing.
NEXT_PUBLIC_QREACH=

# Required. Block number of the deployment transaction (receipts[0].blockNumber in run-latest.json).
# The indexer reads event logs from this block. 0 works but makes the first page load scan the whole chain.
NEXT_PUBLIC_DEPLOY_BLOCK=

# Only needed off mainnet. On chain 1990 the app uses the official addresses in lib/config.ts:
#   QUSDC   0x3F43DA82eC9A4f5285F10FaF1F26EcA7319E5DA5
#   QIE ID  0x9aab56e7727af53A3131985BFB16d845319b7bdc
# The QIEDEX router (0x08cd2e72e156D8563B4351eb4065C262A9f553Ef) and QIE price oracle
# (0x3Bc617cF3A4Bb77003e4c556B87b13D556903D17) are built in too; the oracle is always read from mainnet.
NEXT_PUBLIC_QUSDC=
NEXT_PUBLIC_QIEID=

# Optional. Public repository link shown on /judge.
NEXT_PUBLIC_REPO_URL=
